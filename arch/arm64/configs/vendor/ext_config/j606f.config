#
# Lenovo Tab P11 TB-J606F. Se aplica sobre vendor/bengal-perf_defconfig.
# Los valores salen de la configuracion del kernel stock S320383.
#
CONFIG_LENOVO=y
CONFIG_BACKLIGHT_SGM37604=y
CONFIG_LCD_BIAS_TPS65132=y
CONFIG_LCD_CLASS_DEVICE=m
CONFIG_INPUT_HALL_SENSOR=y
CONFIG_VITURALSAR=y
CONFIG_TCPC_CLASS=y
CONFIG_TCPC_RT1711H=y
CONFIG_USB_POWER_DELIVERY=y
# CONFIG_USB_PD_POLICY is not set
CONFIG_USB_PD_VBUS_STABLE_TOUT=125
CONFIG_SND_SOC_ES7210=y
CONFIG_SND_SOC_DBMDX=y
CONFIG_SND_SOC_DBMDX_AEC_REF_32_TO_16_BIT=y
CONFIG_SND_SOC_DBMDX_I2S_BUFFERING_SUPPORTED=y
CONFIG_SND_SOC_DBMDX_I2S_CAPTURE_DEVICE=y
CONFIG_SND_SOC_DBMDX_OKG_2_CH_AEC_ONLY=y
CONFIG_SND_SOC_DBMDX_OKG_WWE_SUPPORT=y
CONFIG_SND_SOC_DBMDX_USE_ANALOG_MICS=y
CONFIG_SND_SOC_DBMDX_VA_I2S_MASTER=y
# CONFIG_TOUCHSCREEN_NT36XXX is not set
CONFIG_TOUCHSCREEN_NT36xxx_HOSTDL_SPI=y
CONFIG_TOUCHSCREEN_HIMAX_CHIPSET=y
CONFIG_TOUCHSCREEN_HIMAX_COMMON=y
CONFIG_TOUCHSCREEN_HIMAX_DEBUG=y
CONFIG_TOUCHSCREEN_HIMAX_IC_HX83102=y
CONFIG_TOUCHSCREEN_HIMAX_INCELL=y
CONFIG_TOUCHSCREEN_HIMAX_INSPECT=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_I2C_HID=y
CONFIG_LEDS_CLASS=y
CONFIG_NEW_LEDS=y
CONFIG_PWM_SYSFS=y
CONFIG_BLK_DEV_LOOP_MIN_COUNT=16

# El tactil Novatek y Himax se enlazan al panel solo con CONFIG_FB.
CONFIG_FB=y

# WLAN como modulo, igual que en el Pro1-X
CONFIG_QCA_CLD_WLAN=m

# Registros que sobreviven a un reinicio: el kernel stock no los tiene.
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y
CONFIG_MM8013_FG=y
CONFIG_POGO=y
CONFIG_FUSB_30X=y
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_CFI_PERMISSIVE=y
